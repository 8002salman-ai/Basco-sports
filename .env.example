# Public Supabase settings (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only Supabase admin access (never expose publicly)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin authentication
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=pbkdf2$iterations$salt$hash
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Payments (Stripe)
PAYMENT_PROVIDER=demo
# Set to 'stripe' to enable live payments
# NEXT_PUBLIC_BASCO_PAYMENT_MODE=live
# STRIPE_SECRET_KEY=sk_live_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Email notifications (Resend)
# RESEND_API_KEY=re_...
# EMAIL_FROM=Basco Sports <orders@basco-sports.vercel.app>

# Optional integrations
NEXT_PUBLIC_SITE_URL=https://basco-sports.vercel.app
HERMES_ENABLED=false
HERMES_BASE_URL=
HERMES_API_KEY=
