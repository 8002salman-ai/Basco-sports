# Basco Sports – Environment Variables Example
# Copy to .env.local for local development. Never commit real secrets.
# All values below are obvious dummy placeholders – replace with real values in Vercel / Cloudflare Pages dashboard.

# ------------------------------
# Public / Client-side (NEXT_PUBLIC_ prefix)
# ------------------------------
# Google Analytics 4 – Measurement ID format G-XXXXXXXXXX
# Get from: Google Analytics > Admin > Data Streams > Web Stream
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google AdSense – Publisher Client ID format ca-pub-XXXXXXXXXXXXXXXX
# Get from: AdSense dashboard > Account > Settings
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# Optional AdSense Ad Slot IDs (numeric, from AdSense > Ads > Ad Units)
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=XXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=XXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=XXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_PRODUCT=XXXXXXXXXX

# Payments – Demo vs Live mode (client-side flag only, no secret)
NEXT_PUBLIC_BASCO_PAYMENT_MODE=demo
# Stripe Publishable Key (public, safe for client, but use test placeholder here)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_XXXXXXXXXXXXXXXX

# Site URL (optional, for sitemap / OG)
NEXT_PUBLIC_SITE_URL=https://basco-sports.example.com

# Supabase – Admin data layer (products/orders/users/store_settings)
# NEXT_PUBLIC_SUPABASE_URL + anon key are PUBLIC by design (RLS protects tables).
# Schema: supabase/migrations/0001_admin_schema.sql
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------
# Server-side only (NEVER expose to client)
# ------------------------------
# Google Search Console – HTML tag verification token (meta content only, not full tag)
# Get from: Search Console > Settings > Ownership verification > HTML tag
GOOGLE_SITE_VERIFICATION=your-google-site-verification-token

# Admin Access – Requires env-provided credentials (pbkdf2 only)
# ADMIN_EMAIL – admin login email (must not be used as password)
ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD_HASH – pbkdf2 format only: pbkdf2$iterations$saltBase64$derivedKeyBase64
# WebCrypto PBKDF2 (SHA-256, 600000 iterations, 16-byte salt, 64-byte derived key) –
# works on BOTH Edge runtimes (Cloudflare/Vercel edge) and Node.js (scrypt is Node-only,
# so it is NOT accepted anymore).
# Generate locally WITHOUT exposing real password, using Node's WebCrypto (Node 20+ has
# globalThis.crypto):
#   node -e "const {subtle,getRandomValues}=globalThis.crypto; (async()=>{const salt=getRandomValues(new Uint8Array(16)); const key=await subtle.deriveBits({name:'PBKDF2',hash:'SHA-256',salt,saltLength:16,iterations:600000},await subtle.importKey('raw',new TextEncoder().encode('REPLACE_WITH_STRONG_PASSWORD'),'PBKDF2',false,['deriveBits']),512); const b64=(u)=>Buffer.from(u).toString('base64'); console.log('pbkdf2$600000$'+b64(salt)+'$'+b64(key))})()"
# IMPORTANT local-only gotcha: Next.js expands $ signs in .env files. If you copy the hash
# into a LOCAL .env.local, escape every $ as \$ (e.g. pbkdf2\$600000\$...). In Vercel /
# Cloudflare Pages dashboards paste the hash as-is (no escaping needed).
# Only pbkdf2 format is valid now. scrypt, SHA-256 and bcrypt are rejected.
# Example placeholder (NOT a real hash, will be treated as not configured):
ADMIN_PASSWORD_HASH=pbkdf2$600000$REPLACE_WITH_BASE64_SALT$REPLACE_WITH_BASE64_DERIVED_KEY
# ADMIN_SESSION_SECRET – 64+ char random string for signing admin session cookies (HMAC SHA256, httpOnly)
# Generate: openssl rand -base64 48  OR  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-64-char-random-string-for-session-signing

# Supabase service-role key – SERVER-ONLY secret used by /api/admin/db for admin
# CRUD (bypasses RLS). Never expose client-side, never prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Payments – Server-side provider selection and secrets
# Options: demo | stripe | paypal
PAYMENT_PROVIDER=demo
# Stripe Secret Key – server only, never prefix with NEXT_PUBLIC
STRIPE_SECRET_KEY=sk_test_placeholder_XXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_placeholder_XXXXXXXXXXXXXXXX

# Hermes Connector – Generic custom API integration (configurable)
# Do not assume which Hermes service – treat as custom API
# HERMES_ENABLED=true to enable connector, false to disable
HERMES_ENABLED=false
# Base URL of Hermes API (e.g., the Salman OS Hermes bridge / Hermes Agent API URL)
HERMES_BASE_URL=https://api.hermes.example.com
# API Key for Hermes – server only
HERMES_API_KEY=hm_placeholder_api_key_XXXXXXXXXXXXXXXX

# Node environment
NODE_ENV=development
